# Kobiton REST credentials — HTTP Basic auth (username + API key).
# Get/rotate the key at https://portal.kobiton.com → Settings → API key.
# Read from the environment only; never hardcoded, never logged.
KOBITON_USERNAME=your-kobiton-username
KOBITON_API_KEY=your-kobiton-api-key

# Optional overrides:
# KOBITON_API_URL=https://api.kobiton.com
# KOBITON_DEBUG=1
